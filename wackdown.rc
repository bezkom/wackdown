// Template processed by build.rs (fills in @ROOT@ and the version from Cargo.toml).
#include <winver.h>

// Icon order matters: index 0 is the app icon, index 1 the .md document icon ("wackdown.exe,1").
1 ICON "@ROOT@/assets/icon/wackdown.ico"
2 ICON "@ROOT@/assets/icon/document.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @MAJOR@, @MINOR@, @PATCH@, 0
PRODUCTVERSION  @MAJOR@, @MINOR@, @PATCH@, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "WackDown Core"
            VALUE "FileDescription",  "WackDown Markdown Viewer"
            VALUE "FileVersion",      "@VERSION@"
            VALUE "InternalName",     "wackdown"
            VALUE "LegalCopyright",   "GPL-3.0-or-later. AI-generated with Claude Code."
            VALUE "OriginalFilename", "wackdown.exe"
            VALUE "ProductName",      "WackDown"
            VALUE "ProductVersion",   "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
