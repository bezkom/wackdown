# Normalize text to LF in the repository, regardless of the committer's settings.
* text=auto eol=lf

# Windows tools that expect CRLF.
*.reg  text eol=crlf
*.ps1  text eol=crlf
*.iss  text eol=crlf
*.rc   text eol=crlf

# Binary assets: never touch.
*.ttf  binary
*.ico  binary
*.png  binary

# Vendored test data (CommonMark / GFM spec examples): not counted as project code on GitHub.
tests/fixtures/*.json linguist-vendored
