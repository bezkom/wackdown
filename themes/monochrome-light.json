{
  "id": "monochrome-light",
  "name": "Monochrome Light",
  "author": "WackDown Core",
  "version": "1.0.0",
  "mood": "Black on white. Nothing else.",
  "description": "For boring people. Grayscale only, so it also prints well: dark themes use it on paper.",
  "colors": {
    "background": "#ffffff",
    "text": "#1b1b1b",
    "textDim": "#707070",
    "selection": "#00000022",
    "heading1": "#000000",
    "heading2": "#000000",
    "heading3": "#1b1b1b",
    "heading4": "#1b1b1b",
    "heading5": "#333333",
    "heading6": "#333333",
    "codeBackground": "#f2f2f2",
    "codeBorder": "#d9d9d9",
    "codeText": "#1b1b1b",
    "codeKeyword": "#000000",
    "codeString": "#4a4a4a",
    "codeComment": "#8a8a8a",
    "codeFunction": "#1b1b1b",
    "codeNumber": "#4a4a4a",
    "blockquoteBorder": "#9a9a9a",
    "blockquoteBackground": "#f7f7f7",
    "blockquoteText": "#3a3a3a",
    "hrColor": "#dcdcdc",
    "tableHeaderBackground": "#ececec",
    "tableBorder": "#d4d4d4",
    "tableRowAlt": "#f7f7f7",
    "tableRowHover": "#e6e6e6",
    "link": "#1b1b1b",
    "tagBackground": "#00000012",
    "tagText": "#333333",
    "accent": "#555555",
    "scrollbarThumb": "#00000040",
    "scrollbarThumbHover": "#00000080",
    "scrollbarTrack": "#ffffff",
    "checkboxBorder": "#555555",
    "checkboxCheck": "#1b1b1b",
    "calloutNote": "#444444",
    "calloutTip": "#444444",
    "calloutWarning": "#444444"
  },
  "typography": {
    "fontSize": 15,
    "lineHeight": 1.6,
    "h1Scale": 1.8,
    "h2Scale": 1.45,
    "h3Scale": 1.25,
    "h4Scale": 1.1,
    "h5Scale": 1.0,
    "h6Scale": 1.0,
    "codeScale": 0.92,
    "fontFamily": "\"Iosevka Aile\", sans-serif",
    "headingFontFamily": "\"Iosevka Aile\", sans-serif",
    "codeFontFamily": "\"Iosevka\", monospace"
  },
  "layout": {
    "paddingX": 48,
    "paddingY": 40,
    "maxWidth": 960,
    "borderRadius": 2,
    "itemSpacing": 16,
    "measure": 100
  }
}
